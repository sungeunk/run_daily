[Unit]
Description=Daily Streamlit viewer (sungeunk user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DAILY_DB=/mnt/hdd/daily/db/daily_llm_benchmark.duckdb
Environment=INGEST_LOCK_FILE=/mnt/hdd/daily/db/.ingest.lock
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/usr/local/bin/uv run --python 3.12 --with-requirements daily/requirements.txt streamlit run daily/viewer/app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target