[Unit]
Description=Daily results MCP server (sungeunk user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uv run --python 3.12 --with-requirements daily/requirements.txt python -m daily.mcp_server.server --db /mnt/hdd/daily/db/daily_llm_benchmark.duckdb --transport streamable-http --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target