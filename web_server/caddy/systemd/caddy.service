[Unit]
Description=Caddy web server (sungeunk user)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/caddy run --environ --config %h/repo/run_daily/web_server/caddy/Caddyfile --adapter caddyfile
ExecReload=%h/.local/bin/caddy reload --config %h/repo/run_daily/web_server/caddy/Caddyfile --adapter caddyfile
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

[Install]
WantedBy=default.target
