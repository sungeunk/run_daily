:8081 {
    encode gzip

    @raw path *.raw
    header @raw Content-Type "text/plain; charset=utf-8"

    @parquet path *.parquet
    header @parquet Content-Type "application/octet-stream"
    header @parquet Content-Disposition "attachment"

    redir /daily /daily/ 308
    redir /daily2 /daily2/ 308
    redir /benchmarking_datasets /benchmarking_datasets/ 308
    redir /model_cache_server /model_cache_server/ 308

    handle_path /daily/* {
        root * /mnt/hdd/daily
        file_server browse
    }

    handle_path /daily2/* {
        root * /var/www/html/daily2
        file_server browse
    }

    handle_path /benchmarking_datasets/* {
        root * /mnt/hdd/jenkins
        file_server browse
    }

    handle_path /model_cache_server/* {
        root * /mnt/hdd/model
        file_server browse
    }
}
